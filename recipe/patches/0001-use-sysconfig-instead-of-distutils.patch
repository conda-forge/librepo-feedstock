From 69b53287d6d30551724bade88e09a47ba37a2244 Mon Sep 17 00:00:00 2001
From: conda-forge <conda-forge@users.noreply.github.com>
Date: Sat, 21 Nov 2026 08:12:47 +0100
Subject: [PATCH] Use sysconfig instead of distutils to find the Python install
 dir

distutils was removed in Python 3.12, which left PYTHON_INSTALL_DIR empty
and installed the Python module to the wrong location.
---
 librepo/python/python3/CMakeLists.txt | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/librepo/python/python3/CMakeLists.txt b/librepo/python/python3/CMakeLists.txt
index 52ba44e..3408ee9 100644
--- a/librepo/python/python3/CMakeLists.txt
+++ b/librepo/python/python3/CMakeLists.txt
@@ -1,7 +1,7 @@
 EXECUTE_PROCESS(COMMAND ${PYTHON_EXECUTABLE} -c "
 from sys import stdout
-from distutils import sysconfig
-path=sysconfig.get_python_lib(True, prefix='${CMAKE_INSTALL_PREFIX}')
+import sysconfig
+path=sysconfig.get_path('platlib', vars={'base': '${CMAKE_INSTALL_PREFIX}', 'platbase': '${CMAKE_INSTALL_PREFIX}'})
 stdout.write(path)"
 OUTPUT_VARIABLE PYTHON_INSTALL_DIR)
 INCLUDE_DIRECTORIES (${PYTHON_INCLUDE_PATH})
-- 
2.56.0

